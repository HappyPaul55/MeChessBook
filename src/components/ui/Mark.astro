---
interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className = "" } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role="img"
  aria-label="Me Chess Book"
  class={`shrink-0 ${className}`}
>
  <rect width="64" height="64" rx="14" fill="#FFD400"></rect>
  <g fill="#0C0D0A">
    <circle cx="32" cy="18.5" r="7.5"></circle>
    <rect x="25.5" y="25" width="13" height="4.5" rx="2.25"></rect>
    <path d="M27.5 29.5h9l3.5 13.5h-16z"></path>
    <rect x="19" y="43" width="26" height="7" rx="2.5"></rect>
  </g>
</svg>
