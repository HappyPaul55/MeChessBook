---
import { buttonClass, type ButtonVariant } from "../../lib/button";

interface Props {
  href?: string;
  variant?: ButtonVariant;
  external?: boolean;
  type?: "button" | "submit";
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  external = false,
  type = "button",
  class: className = "",
  ...rest
} = Astro.props;

const cls = buttonClass(variant, className);
const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

{
  href ? (
    <a href={href} class={cls} target={target} rel={rel} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={cls} {...rest}>
      <slot />
    </button>
  )
}
