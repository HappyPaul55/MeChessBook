---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";

const highlights = [
  { value: "A4 · A5", label: "Page sizes" },
  { value: "Lichess", label: "Games from" },
  { value: "None", label: "Accounts" },
];
---

<section
  class="on-ink grid-ink relative isolate overflow-hidden border-b border-line-ink bg-ink pt-[clamp(7rem,15vw,10.5rem)] pb-[clamp(3rem,7vw,5rem)]"
>
  <Container>
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p class="comment">
          <span class="slash" aria-hidden="true">//</span> for lichess players
        </p>

        <h1
          class="mt-5 font-display text-[clamp(2.4rem,5.6vw,4.1rem)] leading-[0.98] font-bold tracking-[-0.035em] text-balance text-cream"
        >
          Your chess games, <span class="mark">as a real book.</span>
        </h1>

        <p
          class="mt-6 max-w-[42rem] text-[clamp(1rem,1.5vw,1.18rem)] leading-[1.6] text-[rgba(250,250,244,0.72)]"
        >
          Me Chess Book fetches your Lichess games, finds the interesting moment
          in each one, and lays them out as a printed book — the strongest game
          first, fresh notes pages at the back. Nothing is uploaded, and there
          is no account to make.
        </p>

        <div class="no-print mt-8 flex flex-wrap items-center gap-3.5">
          <Button href="/make" variant="primary">Make a book</Button>
          <Button href="/how-to-print" variant="outlineInk">
            How printing works
          </Button>
        </div>
      </div>

      <div class="justify-self-center lg:justify-self-end" aria-hidden="true">
        <div
          class="relative aspect-[148/210] w-[min(320px,78vw)] -rotate-2 overflow-hidden rounded-[6px] border border-line-ink-strong bg-ink shadow-[12px_12px_0_0_var(--color-yellow)]"
        >
          <img
            src="/covers/3.jpg"
            alt=""
            width="148"
            height="210"
            class="absolute inset-0 h-full w-full object-cover"
          />
          <div
            class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent px-6 pt-24 pb-8 text-center font-[Anton] leading-none text-cream"
          >
            <div class="text-[0.95rem] tracking-[0.16em] opacity-80">THE</div>
            <div class="mt-3 text-[1.9rem]">Your Name</div>
            <div class="text-[1.9rem]">Chess Book</div>
          </div>
        </div>
      </div>
    </div>

    <dl
      class="mt-[clamp(2.5rem,6vw,4rem)] grid grid-cols-1 gap-px overflow-hidden rounded-[6px] border border-line-ink bg-[rgba(250,250,244,0.08)] sm:grid-cols-3"
    >
      {
        highlights.map((item) => (
          <div class="bg-ink px-5 py-5">
            <dt class="font-mono text-[0.68rem] font-bold tracking-[0.12em] text-[rgba(250,250,244,0.52)] uppercase">
              {item.label}
            </dt>
            <dd class="mt-2 font-display text-[clamp(1.6rem,3vw,2.1rem)] leading-none font-bold text-yellow">
              {item.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </Container>
</section>
